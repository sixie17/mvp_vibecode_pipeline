# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# LLM provider/model — selectable per request on /api/agents/run/ and
# defaulted here for Lane 1's ticket-refine step. `provider` must be one
# LangChain's init_chat_model recognizes (e.g. "openai", "anthropic"); only
# the API key for whichever provider(s) you actually use is required.
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith observability
# https://docs.smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=mvp_vibecode_pipeline
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com

# Linear — Lane 1's trigger (see CLAUDE.md "Lane 1" and linear/services.py).
# Requires the Linear<->GitHub integration installed on the target team first.
LINEAR_API_KEY=
# Signing secret shown when creating the webhook in Linear's settings.
LINEAR_WEBHOOK_SECRET=
# The Linear user id (not name/email) of the bot/account this pipeline acts as.
LINEAR_BOT_USER_ID=
# Linear's own hosted MCP server, used by the refine step's tool-using agent.
# Read-only on purpose (see linear/mcp.py) — the agent can't write to Linear
# even if it tried; LINEAR_API_KEY above is sent to it as a bearer token.
LINEAR_MCP_URL=https://mcp.linear.app/mcp/readonly

# The target repo Lane 1 plans/codes against (step 5, planner/). Linear's API
# has no field exposing which GitHub repo a team/issue is connected to, so
# this app holds it as config — one target repo per deployment for now.
TARGET_REPO_CLONE_URL=
TARGET_REPO_DEFAULT_BRANCH=main
# Optional, for a private repo: a fine-grained PAT or GitHub App installation
# token scoped to just that repo. Injected into the clone URL as an HTTPS
# credential (not an SSH deploy key — see CLAUDE.md). Leave blank if public.
TARGET_REPO_ACCESS_TOKEN=

# GitHub — Lane 1 step 9's trigger (listening for PR review events; see
# CLAUDE.md "Lane 1" and github/services.py). No API token yet — this app
# only verifies and logs incoming webhooks so far, it doesn't call GitHub.
# Secret configured when creating the webhook in the repo's settings.
GITHUB_WEBHOOK_SECRET=
